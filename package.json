{
  "name": "powerplugpicks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:invites": "node scripts/verify-invites.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:header": "node scripts/verify-header.mjs",
    "verify:jobs-media": "node scripts/verify-jobs-media.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./scripts/seed.sql",
    "demo:seed": "node scripts/demo/manage.mjs seed",
    "demo:remove": "node scripts/demo/manage.mjs remove",
    "demo:verify": "node scripts/demo/verify.mjs",
    "setup": "node scripts/setup.mjs",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@tiptap/extension-link": "latest",
    "@tiptap/extension-placeholder": "latest",
    "@tiptap/extension-image": "latest",
    "@tiptap/extension-table": "latest",
    "@tiptap/react": "latest",
    "@tiptap/starter-kit": "latest",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "lucide-react": "latest",
    "next": "16.3.8",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.145.0"
  },
  "engines": { "node": ">=22.0.0" }
}
