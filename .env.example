# Cloudflare secrets belong in .dev.vars locally and wrangler secret put remotely.
# Run npm run setup to generate unique LOCAL secrets. Never commit .dev.vars.
APP_ENV=development
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BOOTSTRAP_TOKEN=replace-with-a-random-one-time-setup-token
CRON_SECRET=replace-with-a-random-scheduler-secret
ENABLE_INDEXING=false
# Optional email delivery
RESEND_API_KEY=
EMAIL_FROM=
