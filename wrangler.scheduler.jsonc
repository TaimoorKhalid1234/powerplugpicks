{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"powerplugpicks-scheduler",
 "main":"workers/scheduler.ts",
 "compatibility_date":"2026-09-01",
 "triggers":{"crons":["*/5 * * * *"]},
 "services":[{"binding":"APP","service":"powerplugpicks"}],
 "vars":{"SITE_URL":"https://powerplugpicks.powerplugpicks.workers.dev"},
 "observability":{"enabled":true}
}
